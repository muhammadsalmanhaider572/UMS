@{
    ViewData["Title"] = "Registered Users";
}

<div class="container-fluid mt-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3 gap-2">

        <h3 class="mb-0">Registered Users</h3>

        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">

            <!-- Search -->
            <input type="text"
                   id="txtSearch"
                   class="form-control"
                   placeholder="Search users..."
                   style="width:220px;" />

            <button class="btn btn-primary"
                    id="btnSearch">
                <i class="bi bi-search"></i>
            </button>

            <!-- Add User -->
            <a href="/RegistrationUser/RegistrationUser"
               class="btn btn-success">
                <i class="bi bi-person-plus-fill"></i>
                Add User
            </a>

        </div>

    </div>

    <!-- Users Table -->
    <div class="table-responsive">

        <table class="table table-bordered table-hover table-striped align-middle text-nowrap"
               id="tblUsers">

            <thead class="table-dark">

                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Username</th>
                    <th>Created Date</th>
                    <th class="text-center">Action</th>
                </tr>

            </thead>

            <tbody>
            </tbody>

        </table>

    </div>

    <div class="d-flex justify-content-end align-items-center mt-3">

        <button class="btn btn-outline-primary me-2"
                id="btnPrev">
            <i class="bi bi-chevron-left"></i>
            Previous
        </button>

        <span id="pageInfo" class="fw-bold mx-2">
            Page 1 of 1
        </span>

        <button class="btn btn-outline-primary ms-2"
                id="btnNext">
            Next
            <i class="bi bi-chevron-right"></i>
        </button>

    </div>
</div>

@section Scripts
{
    @* <script src="~/js/GetUser.js"></script> *@
    <script src="~/js/AddUser.js"></script>
}