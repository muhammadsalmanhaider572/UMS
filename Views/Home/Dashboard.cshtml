@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Dashboard</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>

<body class="bg-light">

    <nav class="navbar navbar-dark bg-primary">

        <div class="container-fluid">

            <span class="navbar-brand">

                User Management System

            </span>

            <a href="/Home/Logout"
               class="btn btn-light">

                Logout

            </a>

        </div>

    </nav>

    <div class="container mt-5">

        <div class="row">

            <div class="col-md-6">

                <h2>

                    Welcome,

                    <span class="text-primary">

                        @ViewBag.Username

                    </span>

                </h2>

                <hr />

                <p class="lead">

                    Welcome to the User Management System.

                </p>

                <p>

                    You have successfully logged into the application.

                </p>

            </div>

            <div class="col-md-6 text-center">

                <img src="https://th.bing.com/th?q=Rustic+Wood+Welcome+Sign&w=120&h=120&c=1&rs=1&qlt=70&r=0&o=7&cb=1&dpr=1.5&pid=InlineBlock&rm=3&mkt=en-SG&cc=SG&setlang=en&adlt=strict&t=1&mw=247"
                     class="img-fluid"
                     height="400px";
                     width="400px"/>

            </div>

        </div>

    </div>

</body>

</html>